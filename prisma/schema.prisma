generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  phone            String?
  governmentIdHash String?        @unique
  googleSub        String?        @unique
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  authProvider     String?        @default("local")
  lastLoginAt      DateTime?
  publicAlias      String
  role             String         @default("CITIZEN")
  accountStatus    String         @default("ACTIVE")
  trustScore       Int            @default(70)
  strikes          Int            @default(0)
  reports          Report[]
  helpRequests     HelpRequest[]
  sanctionCreated  Sanction[]     @relation("SanctionCreator")
  sanctions        Sanction[]     @relation("SanctionTarget")
  auditLogs        AuditLog[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Report {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  category        String
  title           String
  description     String
  latitude        Float
  longitude       Float
  locationText    String?
  severity        String         @default("LOW")
  status          String         @default("NEW")
  aiSummary       String?
  aiRecommendation String?
  aiConfidence    Int?
  falseReportRisk Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model HelpRequest {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  category        String
  title           String
  description     String
  latitude        Float
  longitude       Float
  locationText    String?
  priority        String         @default("LOW")
  status          String         @default("RECEIVED")
  restrictedMode  Boolean        @default(false)
  aiSummary       String?
  aiRecommendation String?
  aiConfidence    Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model Sanction {
  id          String   @id @default(cuid())
  user        User     @relation("SanctionTarget", fields: [userId], references: [id])
  userId      String
  type        String
  reason      String
  createdBy   User?    @relation("SanctionCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
}

model ExternalEvent {
  id           String   @id @default(cuid())
  sourceId     String
  externalId   String
  category     String
  title        String
  description  String?
  severity     String?
  confidence   Int?
  latitude     Float?
  longitude    Float?
  locationName String?
  country      String?
  sourceUrl    String?
  occurredAt   DateTime?
  fetchedAt    DateTime?
  lastSeenAt   DateTime?
  expiresAt    DateTime?
  raw          Json?
  normalized   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([category])
  @@index([occurredAt])
  @@index([severity])
}

model IngestionRun {
  id          String    @id @default(cuid())
  sourceId    String
  status      String
  fetchedAt   DateTime  @default(now())
  completedAt DateTime?
  count       Int?
  cached      Boolean   @default(false)
  error       String?
  durationMs  Int?
  metadata    Json?

  @@index([sourceId])
  @@index([fetchedAt])
}

model ExternalEventCorrelation {
  id          String   @id @default(cuid())
  kind        String
  confidence  Int?
  explanation String?
  sourceIds   Json
  eventIds    Json
  createdAt   DateTime @default(now())
  metadata    Json?

  @@index([kind])
  @@index([createdAt])
}

model RiskAssessment {
  id                      String   @id @default(cuid())
  riskType                String
  status                  String
  probabilityBand         String
  probabilityScore        Int
  confidence              Int
  severity                String
  title                   String
  summary                 String
  recommendedAction       String
  timeframe               String?
  relatedExternalEventIds Json
  evidence                Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  nextReviewAt            DateTime?
  metadata                Json?

  @@index([riskType])
  @@index([status])
  @@index([probabilityBand])
  @@index([createdAt])
}

model RiskAssessmentRevision {
  id                       String   @id @default(cuid())
  assessmentId             String
  previousStatus           String?
  newStatus                String
  previousProbabilityScore Int?
  newProbabilityScore      Int
  reason                   String
  evidence                 Json?
  createdAt                DateTime @default(now())
}

model HazardKnowledgeDocument {
  id               String   @id @default(cuid())
  title            String
  sourceName       String
  sourceUrl        String
  publisher        String?
  country          String?
  hazardType       String
  language         String?
  publishedYear    Int?
  notes            String?
  documentCategory String?
  ingestionStatus  String?  @default("queued")
  priority         Int?     @default(3)
  reliabilityScore Int?     @default(80)
  publicationYear  Int?
  institution      String?
  countryFocus     String?
  regionFocus      String?
  hazardTypes      Json?
  tags             Json?
  limitationNote   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HazardKnowledgeFact {
  id                    String    @id @default(cuid())
  documentId            String?
  hazardType            String
  knowledgeType         String
  title                 String
  summary               String
  country               String?
  region                String?
  latitude              Float?
  longitude             Float?
  year                  Int?
  eventDate             DateTime?
  magnitude             Float?
  magnitudeLabel        String?
  depthKm               Float?
  ruptureLengthKm       Float?
  maxSeaLevelVariationM Float?
  affectedCoastKm       Float?
  casualtiesText        String?
  confidence            Int
  tags                  Json?
  sourceName            String
  sourceUrl             String
  documentCategory      String?
  relevanceScore        Int?      @default(50)
  limitationNote        String?
  extractionStatus      String?   @default("manual_review")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([hazardType])
  @@index([country])
  @@index([region])
  @@index([year])
  @@index([magnitude])
}
