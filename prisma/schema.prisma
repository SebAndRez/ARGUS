generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  phone               String?
  governmentIdHash    String?              @unique
  passwordHash        String?
  countryCode         String?
  city                String?
  region              String?
  preferredLanguage   String?
  unitSystem          String?
  googleSub           String?              @unique
  avatarUrl           String?
  emailVerifiedAt     DateTime?
  termsAcceptedAt     DateTime?
  privacyAcceptedAt   DateTime?
  profileCompletedAt  DateTime?
  authProvider        String?              @default("local")
  lastLoginAt         DateTime?
  publicAlias         String
  role                String               @default("CITIZEN")
  accountStatus       String               @default("ACTIVE")
  trustScore          Int                  @default(70)
  strikes             Int                  @default(0)
  reports             Report[]
  helpRequests        HelpRequest[]
  sanctionCreated     Sanction[]           @relation("SanctionCreator")
  sanctions           Sanction[]           @relation("SanctionTarget")
  auditLogs           AuditLog[]
  preparednessProfile PreparednessProfile?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Report {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  category         String
  title            String
  description      String
  latitude         Float
  longitude        Float
  locationText     String?
  severity         String   @default("LOW")
  status           String   @default("NEW")
  aiSummary        String?
  aiRecommendation String?
  aiConfidence     Int?
  falseReportRisk  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HelpRequest {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  category         String
  title            String
  description      String
  latitude         Float
  longitude        Float
  locationText     String?
  priority         String   @default("LOW")
  status           String   @default("RECEIVED")
  restrictedMode   Boolean  @default(false)
  aiSummary        String?
  aiRecommendation String?
  aiConfidence     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model Sanction {
  id          String   @id @default(cuid())
  user        User     @relation("SanctionTarget", fields: [userId], references: [id])
  userId      String
  type        String
  reason      String
  createdBy   User?    @relation("SanctionCreator", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
}

model ExternalEvent {
  id           String    @id @default(cuid())
  sourceId     String
  externalId   String
  category     String
  title        String
  description  String?
  severity     String?
  confidence   Int?
  latitude     Float?
  longitude    Float?
  locationName String?
  country      String?
  sourceUrl    String?
  occurredAt   DateTime?
  fetchedAt    DateTime?
  lastSeenAt   DateTime?
  expiresAt    DateTime?
  raw          Json?
  normalized   Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([category])
  @@index([occurredAt])
  @@index([severity])
}

model IngestionRun {
  id          String    @id @default(cuid())
  sourceId    String
  status      String
  fetchedAt   DateTime  @default(now())
  completedAt DateTime?
  count       Int?
  cached      Boolean   @default(false)
  error       String?
  durationMs  Int?
  metadata    Json?

  @@index([sourceId])
  @@index([fetchedAt])
}

model ExternalEventCorrelation {
  id          String   @id @default(cuid())
  kind        String
  confidence  Int?
  explanation String?
  sourceIds   Json
  eventIds    Json
  createdAt   DateTime @default(now())
  metadata    Json?

  @@index([kind])
  @@index([createdAt])
}

model RiskAssessment {
  id                      String    @id @default(cuid())
  riskType                String
  status                  String
  probabilityBand         String
  probabilityScore        Int
  confidence              Int
  severity                String
  title                   String
  summary                 String
  recommendedAction       String
  timeframe               String?
  relatedExternalEventIds Json
  evidence                Json
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  nextReviewAt            DateTime?
  metadata                Json?

  @@index([riskType])
  @@index([status])
  @@index([probabilityBand])
  @@index([createdAt])
}

model RiskAssessmentRevision {
  id                       String   @id @default(cuid())
  assessmentId             String
  previousStatus           String?
  newStatus                String
  previousProbabilityScore Int?
  newProbabilityScore      Int
  reason                   String
  evidence                 Json?
  createdAt                DateTime @default(now())
}

model HazardKnowledgeDocument {
  id               String   @id @default(cuid())
  title            String
  sourceName       String
  sourceUrl        String
  publisher        String?
  country          String?
  hazardType       String
  language         String?
  publishedYear    Int?
  notes            String?
  documentCategory String?
  ingestionStatus  String?  @default("queued")
  priority         Int?     @default(3)
  reliabilityScore Int?     @default(80)
  publicationYear  Int?
  institution      String?
  countryFocus     String?
  regionFocus      String?
  hazardTypes      Json?
  tags             Json?
  limitationNote   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HazardKnowledgeFact {
  id                    String    @id @default(cuid())
  documentId            String?
  hazardType            String
  knowledgeType         String
  title                 String
  summary               String
  country               String?
  region                String?
  latitude              Float?
  longitude             Float?
  year                  Int?
  eventDate             DateTime?
  magnitude             Float?
  magnitudeLabel        String?
  depthKm               Float?
  ruptureLengthKm       Float?
  maxSeaLevelVariationM Float?
  affectedCoastKm       Float?
  casualtiesText        String?
  confidence            Int
  tags                  Json?
  sourceName            String
  sourceUrl             String
  documentCategory      String?
  relevanceScore        Int?      @default(50)
  limitationNote        String?
  extractionStatus      String?   @default("manual_review")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([hazardType])
  @@index([country])
  @@index([region])
  @@index([year])
  @@index([magnitude])
}

model KnowledgeSource {
  id               String   @id
  name             String
  description      String
  domainsJson      Json
  coverage         Json?
  accessType       String
  status           String
  licenseNotes     String
  updateCadence    String?
  reliabilityScore Int
  officialSource   Boolean  @default(false)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([enabled])
}

model KnowledgeIngestionRun {
  id                String    @id @default(cuid())
  sourceId          String
  sourceName        String
  status            String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  recordsFetched    Int       @default(0)
  recordsNormalized Int       @default(0)
  recordsInserted   Int       @default(0)
  recordsUpdated    Int       @default(0)
  recordsSkipped    Int       @default(0)
  errorMessage      String?
  warningsJson      Json?
  metadataJson      Json?

  @@index([sourceId])
  @@index([status])
  @@index([startedAt])
}

model KnowledgeIncident {
  id                          String    @id @default(cuid())
  externalId                  String?
  sourceId                    String
  sourceName                  String
  title                       String
  summary                     String
  domain                      String
  subtype                     String?
  severity                    String
  confidenceScore             Int
  actionabilityScore          Int
  sourceReliabilityScore      Int
  occurredAt                  DateTime?
  detectedAt                  DateTime?
  country                     String?
  region                      String?
  locality                    String?
  latitude                    Float?
  longitude                   Float?
  geometryJson                Json?
  casualtiesJson              Json?
  impactJson                  Json?
  technicalFactorsJson        Json?
  causesJson                  Json?
  contributingFactorsJson     Json?
  responseActionsJson         Json?
  lessonsLearnedJson          Json?
  recommendedActionsJson      Json?
  relatedHistoricalEventsJson Json?
  similarIncidentIdsJson      Json?
  tagsJson                    Json?
  language                    String?
  rawEvidenceRefsJson         Json?
  reviewStatus                String    @default("pending_review")
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([domain])
  @@index([severity])
  @@index([reviewStatus])
  @@index([occurredAt])
  @@index([latitude, longitude])
}

model KnowledgeEvidence {
  id              String   @id @default(cuid())
  incidentId      String?
  sourceId        String
  sourceName      String
  evidenceType    String
  title           String
  url             String?
  excerpt         String?
  rawRef          String?
  confidenceScore Int
  metadataJson    Json?
  createdAt       DateTime @default(now())

  @@index([incidentId])
  @@index([sourceId])
}

model KnowledgeLesson {
  id                               String   @id @default(cuid())
  incidentId                       String?
  domain                           String
  title                            String
  summary                          String
  whatFailedJson                   Json?
  whatWorkedJson                   Json?
  earlyWarningSignalsJson          Json?
  recommendedPreventiveActionsJson Json?
  recommendedResponseActionsJson   Json?
  applicableToChile                Boolean  @default(false)
  confidenceScore                  Int
  tagsJson                         Json?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@index([incidentId])
  @@index([domain])
}

model KnowledgeDocument {
  id               String   @id @default(cuid())
  sourceId         String?
  title            String
  fileName         String?
  fileMimeType     String?
  sourceUrl        String?
  documentType     String   @default("unknown")
  language         String?
  country          String?
  rawText          String?
  metadataJson     Json?
  processingStatus String   @default("normalized")
  reviewStatus     String   @default("pending_review")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sourceId])
  @@index([documentType])
  @@index([reviewStatus])
}

model KnowledgeDocumentChunk {
  id            String   @id @default(cuid())
  documentId    String
  chunkIndex    Int
  text          String
  tokenEstimate Int
  metadataJson  Json?
  createdAt     DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model KnowledgeEmbeddingRecord {
  id                String   @id @default(cuid())
  documentId        String?
  chunkId           String?
  incidentId        String?
  embeddingProvider String
  embeddingModel    String
  vectorRef         String?
  metadataJson      Json?
  createdAt         DateTime @default(now())

  @@index([documentId])
  @@index([chunkId])
  @@index([incidentId])
}

// --- ARGUS VESTA: preparacion familiar, mochila de emergencia y resiliencia ---
// Datos privados por defecto (ver src/modules/vesta/vestaAccess.ts): solo el
// dueno del perfil puede leer/escribir su propio PreparednessProfile y todo lo
// que cuelga de el.
model PreparednessProfile {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id])
  userId           String    @unique
  riskContextsJson Json?
  lastFullReviewAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  familyPlan        FamilyPlan?
  checklistItems    PreparednessChecklistItem[]
  reminders         PreparednessReminder[]
  emergencyContacts EmergencyContact[]
}

model FamilyPlan {
  id                    String              @id @default(cuid())
  profile               PreparednessProfile @relation(fields: [profileId], references: [id])
  profileId             String              @unique
  membersJson           Json?
  primaryMeetingPoint   String?
  alternateMeetingPoint String?
  evacuationRouteNotes  String?
  medicalNeedsNotes     String?
  petsNotes             String?
  observations          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model EmergencyContact {
  id           String              @id @default(cuid())
  profile      PreparednessProfile @relation(fields: [profileId], references: [id])
  profileId    String
  name         String
  relationship String?
  phone        String?
  email        String?
  priority     Int                 @default(1)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([profileId])
}

model PreparednessChecklistItem {
  id        String              @id @default(cuid())
  profile   PreparednessProfile @relation(fields: [profileId], references: [id])
  profileId String
  category  String
  label     String
  status    String              @default("pending")
  isCustom  Boolean             @default(false)
  notes     String?
  expiresAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([profileId])
  @@index([category])
  @@index([status])
}

model PreparednessReminder {
  id              String              @id @default(cuid())
  profile         PreparednessProfile @relation(fields: [profileId], references: [id])
  profileId       String
  type            String
  title           String
  dueAt           DateTime
  frequencyDays   Int?
  status          String              @default("pending")
  lastCompletedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([profileId])
  @@index([dueAt])
  @@index([status])
}

model KnowledgeAdminReview {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  status     String
  reviewerId String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status])
}

/// Infraestructura critica persistente (hospitales, policia, gobierno, transporte
/// masivo, justicia, refugios, logistica) reutilizable por AURA/FENIX/ARCA/NEXUS/
/// ATLAS/VIGIA/HERMES/ORACULO. Distinto de ExternalEvent (eventos/incidentes) y de
/// KnowledgeEvidence (snapshots de contexto ligados a un incidente): esta tabla
/// guarda un punto por entidad fisica, deduplicado por fuente+id externo, para
/// poder consultarse por zona sin depender de un incidente activo.
model CriticalPoi {
  id                 String    @id @default(cuid())
  externalId         String?
  source             String    @default("osm")
  name               String
  category           String
  priority           String
  latitude           Float
  longitude          Float
  countryCode        String?
  adminLevel1        String?
  adminLevel2        String?
  city               String?
  address            String?
  status             String    @default("active")
  confidence         Int       @default(70)
  lastSeenAt         DateTime?
  lastVerifiedAt     DateTime?
  tagsJson           Json?
  sourceUrl          String?
  isPersistent       Boolean   @default(true)
  isVisibleByDefault Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([category])
  @@index([priority])
  @@index([latitude, longitude])
  @@index([countryCode])
  @@index([status])
}
