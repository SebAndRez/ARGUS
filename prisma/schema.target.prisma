  geometryValidationStatus String?                                     @map("geometry_validation_status") @db.VarChar(50)

  areaKind           AdministrativeAreaKind @relation(fields: [areaKindId], references: [id], onDelete: Restrict)
  jurisdictions      Jurisdiction[]
  exposedPopulations ExposedPopulation[]

  @@map("administrative_areas")
  @@schema("geo")
}

