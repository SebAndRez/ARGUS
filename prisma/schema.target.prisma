/// CriticalInstructionVersion — exact, immutable, chained content (corrects P0-02). [MODIFIED v1.1 — D-01, P2-03: integrity columns + audience_schema_version]
model CriticalInstructionVersion {
  id                      String                                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // UUIDv7 — see SQL_COMPLEMENTARY_REQUIRED: prisma/target-migrations/070_alerts_communications/migration.sql
  criticalInstructionId   String                                       @map("critical_instruction_id") @db.Uuid
  versionNumber           Int                                          @map("version_number")
  content                 String                                       @db.Text
  directiveKind           DirectiveKind                                @map("directive_kind")
  /// Contract VO Audience, shared with alert.alerts.audience
  audience                Json
  audienceSchemaVersion   Int                                          @default(1) @map("audience_schema_version")
  /// SQL_COMPLEMENTARY_REQUIRED: PostGIS geography column, see prisma/target-migrations/070_alerts_communications/migration.sql
  targetArea              Unsupported("geography(MultiPolygon,4326)")? @map("target_area")
  authorityJurisdictionId String?                                      @map("authority_jurisdiction_id") @db.Uuid
  signedByActorType       ActorType                                    @map("signed_by_actor_type")
  /// POLYMORPHIC Actor reference — no physical FK
  signedByActorId         String                                       @map("signed_by_actor_id") @db.Uuid
  signatureIntegrityValue String                                       @map("signature_integrity_value") @db.Text
  /// NEW v1.1 — D-01: documents the algorithm used by signature_integrity_value (never implicitly assumed)
  integrityAlgorithm      String                                       @default("HMAC-SHA256") @map("integrity_algorithm") @db.VarChar(20)
  /// NEW v1.1 — D-01: fixes the canonical row form used to compute the HMAC
  canonicalizationVersion Int                                          @default(1) @map("canonicalization_version")
  /// NEW v1.1 — D-01: references the external key (KMS, outside the database) used for the HMAC, enabling rotation without schema migration
  integrityKeyId          String?                                      @map("integrity_key_id") @db.VarChar(50)
  previousVersionId       String?                                      @map("previous_version_id") @db.Uuid
  nextVersionId           String?                                      @map("next_version_id") @db.Uuid
  supersedesVersionId     String?                                      @map("supersedes_version_id") @db.Uuid
  status                  VersionStatus                                @default(ACTIVE)
  effectiveFrom           DateTime                                     @default(now()) @map("effective_from") @db.Timestamptz(6)
  expiresAt               DateTime?                                    @map("expires_at") @db.Timestamptz(6)
  changeReason            String?                                      @map("change_reason") @db.Text
  createdAt               DateTime                                     @default(now()) @map("created_at") @db.Timestamptz(6)

  criticalInstruction   CriticalInstruction          @relation("InstructionVersions", fields: [criticalInstructionId], references: [id], onDelete: Restrict)
  authorityJurisdiction Jurisdiction?                @relation(fields: [authorityJurisdictionId], references: [id], onDelete: SetNull)
  previousVersion       CriticalInstructionVersion?  @relation("CriticalInstructionVersionPrevious", fields: [previousVersionId], references: [id], onDelete: SetNull)
  previousVersionOf     CriticalInstructionVersion[] @relation("CriticalInstructionVersionPrevious")
  nextVersion           CriticalInstructionVersion?  @relation("CriticalInstructionVersionNext", fields: [nextVersionId], references: [id], onDelete: SetNull)
  nextVersionOf         CriticalInstructionVersion[] @relation("CriticalInstructionVersionNext")
  supersedesVersion     CriticalInstructionVersion?  @relation("CriticalInstructionVersionSupersedes", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededByVersion   CriticalInstructionVersion[] @relation("CriticalInstructionVersionSupersedes")
  currentOfInstructions CriticalInstruction[]        @relation("CurrentVersion")

  deliveryAttempts             DeliveryAttempt[]
  acknowledgements             Acknowledgement[]
  comprehensionConfirmations   ComprehensionConfirmation[]
  instructionAuthorizations    InstructionAuthorization[]
  instructionComplianceRecords InstructionComplianceRecord[]

  /// SQL_COMPLEMENTARY_REQUIRED: uq_civ_instruction_version; ck_civ_order_requires_authority (requires trigger, multi-column); ck_civ_change_reason_required; ck_civ_signature_not_empty; ck_civ_audience_schema_version, see prisma/target-migrations/070_alerts_communications/migration.sql
  @@unique([criticalInstructionId, versionNumber], map: "uq_civ_instruction_version")
  @@map("critical_instruction_versions")
  @@schema("alert")
}

