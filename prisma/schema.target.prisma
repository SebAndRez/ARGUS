  boundary                 Unsupported("geography(MultiPolygon,4326)")
  /// NEW v1.1 — derived, maintained by trg_geo_maintain_centroid_cache
  centroidCache            Unsupported("geography(Point,4326)")?       @map("centroid_cache")
  version                  Int                                         @default(1)
  /// Migration Decision Register D-07 — official, versioned, traceable geometry source. No bbox-derived or synthetic geometry (CREATE_EMPTY until cartographic provider is selected — see prisma/target-migrations/080_geography/migration.sql)
  sourceId                 String?                                     @map("source_id") @db.VarChar(100)
