/// EmergencyProfile — a person's ICE record. [MODIFIED v1.1 — P2-09: UUIDv4 PK instead of UUIDv7, avoids temporal-metadata leakage on a CRITICAL table accessed only via person_id, never range-paginated by id]
model EmergencyProfile {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // UUIDv4 (NOT UUIDv7) — P2-09: avoids leaking approximate creation instant on the most sensitive CRITICAL table
  personId       String                    @unique(map: "uq_emergency_profiles_person_id") @map("person_id") @db.Uuid
  classification InformationClassification @default(CRITICAL)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?                 @map("deleted_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  medicalConditions            MedicalCondition[]
  allergies                    Allergy[]
  currentMedications           CurrentMedication[]
  medicalDevices               MedicalDevice[]
  specialNeeds                 SpecialNeed[]
  emergencyAccesses            EmergencyAccess[]
  emergencyContactDesignations EmergencyContactDesignation[]

  /// Note P3-03 (no design change): kept as 5 separate clinical tables, not a polymorphic clinical_items(kind, ...) table — each clinical type has non-shared columns with distinct validation semantics (dose/frequency, severity, manufacturer/model) that a single JSONB discriminator would obscure precisely on the lowest-tolerable-latency path (emergency medical access)
  /// RLS máxima — misión activa + propósito médico, nunca rol amplio (see ARGUS_PHYSICAL_ACCESS_CONTROL_v1.1_FROZEN.md §4.14)
  @@map("emergency_profiles")
  @@schema("ice")
}

