/// AdministrativeArea — official territorial catalog, basis of Jurisdiction. [MODIFIED v1.1 — P1-02/Corrección#8: area_kind_id replaces area_kind enum; P1-06: centroid_cache; D-01 Migration Decision Register D-07: official-source provenance columns]
model AdministrativeArea {
  id                       String                                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // UUIDv7 — see SQL_COMPLEMENTARY_REQUIRED: prisma/target-migrations/080_geography/migration.sql
