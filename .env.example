DATABASE_URL=
DIRECT_URL=
NASA_FIRMS_MAP_KEY=
# Opcional. Define las areas (bbox) que ARGUS Global Watch consulta en NASA
# FIRMS, como pares "oeste,sur,este,norte" separados por punto y coma. Si se
# deja vacio, src/lib/vigia/globalWatchEngine.ts usa el default operacional
# (Cono Sur + Europa/Mediterraneo): "-76,-56,-66,-17;-11,34,45,62".
ARGUS_FIRMS_BBOXES="-76,-56,-66,-17;-11,34,45,62"
RELIEFWEB_APP_NAME=
# Force /api/argus/events to serve the curated demo dataset instead of the
# live SENAPRED source (screenshots/demos only — leave unset in production).
ARGUS_EVENTS_DEMO_MODE=
# Production guard for seed/demo data. Leave unset in production; set to "true"
# only for an explicitly controlled production demo window.
ARGUS_ALLOW_DEMO_DATA=
# ARGUS Fusion Engine (cross-hazard incident correlation in Global Watch).
# Off by default: cycle-prevention, concurrent-run, notification-throttling
# and privacy-exclusion behavior are not yet covered by tests. Set to "true"
# only after that certification work lands.
ARGUS_ENABLE_FUSION_ENGINE=

# --- Guard de `prisma/seed.ts` / `npm run db:seed` (ver docs/security/DATABASE_SEED_SAFETY.md) ---
# PELIGROSO. Dejar SIEMPRE vacio salvo que necesites sembrar una base remota
# de staging aislada y sepas exactamente lo que haces. El seed es fail-closed:
# produccion, Supabase y cualquier host remoto quedan bloqueados por defecto,
# sin excepcion para Supabase. Para permitir un host remoto NO-Supabase se
# requieren AMBAS variables a la vez (una sola no alcanza):
#   1. ARGUS_ALLOW_REMOTE_SEED=true
#   2. ARGUS_SEED_CONFIRM_HOST=<host exacto de destino, ej. staging-db.example.com>
ARGUS_ALLOW_REMOTE_SEED=
ARGUS_SEED_CONFIRM_HOST=

# --- Selector de rol demo del menu de modulos (ver
#     docs/security/ARGUS_MODULE_ACCESS_BASELINE.md) ---
# PELIGROSO EN APARIENCIA, PERO NO OTORGA PERMISOS REALES: solo controla si
# el selector de "rol de prueba" en /modules (y ModulePlaceholderPage) puede
# influir en la VISTA PREVIA de que modulos se muestran. Dejar SIEMPRE vacio
# en produccion. NODE_ENV=production lo deshabilita sin importar el valor de
# esta variable — no hay forma de anular esa regla desde aqui. Solo util en
# desarrollo local controlado.
NEXT_PUBLIC_ARGUS_ENABLE_DEMO_ROLES=

# --- Ingesta programada externa (.github/workflows/argus-cron.yml y
#     .github/workflows/argus-global-watch.yml) ---
# Vercel Hobby solo permite cron una vez al dia, por eso la ingesta de
# alertas de Chile (~cada 15 min, /api/jobs/run-chile-alerts) y la de ARGUS
# Global Watch (~cada 15 min, /api/jobs/run-global-watch) corren desde
# GitHub Actions en vez de vercel.json. Mismo secreto para ambos jobs: set
# este valor en Vercel (runtime del endpoint) y como secret
# ARGUS_CRON_SECRET en GitHub (mismo valor en ambos lados).
# Sin este valor configurado en el servidor, ambos endpoints rechazan toda
# request (fail-closed), nunca lo dejan abierto.
CRON_SECRET=
# Solo documentado aqui para setearlo como secret ARGUS_PROD_URL en GitHub
# Actions (URL publica del deploy de Vercel, ej. https://argus-b2bs-opal.vercel.app).
# El runtime de Vercel no lo lee.
ARGUS_PROD_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://argus-b2bs-opal.vercel.app/api/auth/google/callback
AUTH_SECRET=

# --- Navegacion GPS / routing (src/lib/routing) ---
# Proveedor activo: osrm (por defecto, sin key) | mapbox | graphhopper | valhalla | google
NEXT_PUBLIC_ROUTING_PROVIDER=osrm
NEXT_PUBLIC_OSRM_BASE_URL=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GRAPHHOPPER_API_KEY=
NEXT_PUBLIC_VALHALLA_BASE_URL=
# Server-only: usada por /api/routing/google-directions, nunca expuesta al cliente.
GOOGLE_DIRECTIONS_API_KEY=

# --- Geocodificacion / buscador de destino (src/lib/geocoding) ---
NEXT_PUBLIC_GEOCODING_PROVIDER=nominatim
NEXT_PUBLIC_NOMINATIM_BASE_URL=

# --- Rate limiting distribuido (ver docs/security/ARGUS_RATE_LIMITING_BASELINE.md) ---
# Backend de produccion para src/lib/security/rateLimit.ts (Upstash Redis
# REST — compatible con multiples instancias serverless de Vercel). Sin
# AMBAS variables configuradas:
#   - fuera de produccion: se usa un contador en memoria del proceso
#     (memory-development) — util para dev/tests, NUNCA protege produccion
#     real porque cada instancia serverless tendria su propio contador.
#   - en produccion: las rutas cuya politica es "fail_closed" (imports de
#     knowledge-intake, sync de POI, ejecucion manual de VIGIA/Chile
#     alertas, login, registro) responden 503 y NO ejecutan la operacion
#     protegida. Las rutas "fail_open_local" (senales moviles/sensores,
#     QuakeSense) se degradan a memoria en vez de bloquear por completo,
#     documentado como no autoritativo.
# No se imprime ni se expone el proveedor/host/credenciales en respuestas
# publicas ni en logs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Credenciales de fuentes no programadas (ver
#     docs/operations/ARGUS_SOURCE_OPERATIONS_BASELINE.md y
#     docs/operations/ARGUS_SOURCE_ACTIVATION_BACKLOG.md) ---
# Ninguna de estas fuentes corre por scheduler todavia (Prompt 16): documentar
# la variable aqui NO las activa ni las agrega a Global Watch, solo permite
# que su estado en `ARGUS_SOURCE_OPERATIONS_REGISTRY` pase de
# `missing_credentials` a poder ejecutarse manualmente via
# /api/knowledge-intake/live/*. Requeridas (bloquean la ejecucion si faltan):
IOC_SLSMF_API_KEY=
OPENAQ_API_KEY=
HAPI_APP_IDENTIFIER=
COPERNICUS_EWDS_API_KEY=
COPERNICUS_GFM_ACCESS_TOKEN=
# Opcionales (el adaptador funciona sin ellas; solo mejoran identificacion/
# limite de tasa ante el proveedor):
NWS_USER_AGENT=
USGS_WATER_API_KEY=
ARGUS_USER_AGENT=

# Copy this file to .env for local development and keep .env out of source control.
# In Vercel production, set GOOGLE_REDIRECT_URI to the deployed app callback URL.
