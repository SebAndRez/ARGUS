DATABASE_URL=
DIRECT_URL=
NASA_FIRMS_MAP_KEY=
RELIEFWEB_APP_NAME=
# Force /api/argus/events to serve the curated demo dataset instead of the
# live SENAPRED source (screenshots/demos only — leave unset in production).
ARGUS_EVENTS_DEMO_MODE=

# --- Ingesta programada externa (.github/workflows/argus-cron.yml) ---
# Vercel Hobby solo permite cron una vez al dia, por eso la ingesta de
# alertas de Chile (~cada 15 min) corre desde GitHub Actions en vez de
# vercel.json. Set este valor en Vercel (runtime del endpoint) y como
# secret ARGUS_CRON_SECRET en GitHub (mismo valor en ambos lados).
# Sin este valor configurado en el servidor, /api/jobs/run-chile-alerts
# rechaza toda request (fail-closed), no lo deja abierto.
CRON_SECRET=
# Solo documentado aqui para setearlo como secret ARGUS_PROD_URL en GitHub
# Actions (URL publica del deploy de Vercel, ej. https://argus-b2bs-opal.vercel.app).
# El runtime de Vercel no lo lee.
ARGUS_PROD_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://argus-b2bs-opal.vercel.app/api/auth/google/callback
AUTH_SECRET=

# --- Navegacion GPS / routing (src/lib/routing) ---
# Proveedor activo: osrm (por defecto, sin key) | mapbox | graphhopper | valhalla | google
NEXT_PUBLIC_ROUTING_PROVIDER=osrm
NEXT_PUBLIC_OSRM_BASE_URL=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GRAPHHOPPER_API_KEY=
NEXT_PUBLIC_VALHALLA_BASE_URL=
# Server-only: usada por /api/routing/google-directions, nunca expuesta al cliente.
GOOGLE_DIRECTIONS_API_KEY=

# --- Geocodificacion / buscador de destino (src/lib/geocoding) ---
NEXT_PUBLIC_GEOCODING_PROVIDER=nominatim
NEXT_PUBLIC_NOMINATIM_BASE_URL=

# Copy this file to .env for local development and keep .env out of source control.
# In Vercel production, set GOOGLE_REDIRECT_URI to the deployed app callback URL.
