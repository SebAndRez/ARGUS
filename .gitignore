# Sensitive document suffixes (explicit, not blanket — do not add *.md/*.docx
# globally, this repo has legitimate public documentation under docs/)
*.local.docx
*.private.docx
*.internal.docx
*.sensitive.docx
*.private.pdf
*.internal.pdf
*.sensitive.pdf
*.audit.md
*.audit.json
*.security-report.*

