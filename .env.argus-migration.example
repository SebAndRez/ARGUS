# Example only — committed to git. Contains NO real secret.
# Copy this to .env.argus-migration.local (git-excluded via .git/info/exclude,
# generated automatically by Invoke-ArgusFullRehearsal.ps1 with a fresh random
# password) before running the rehearsal manually.
#
# Every value here must describe a disposable LOCAL database only.
# See scripts/migration-rehearsal/lib/assert-local-only.mjs for the guard
# that refuses to proceed if any of this points anywhere else.

ARGUS_MIGRATION_LOCAL_ONLY=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=argus_migration_rehearsal
POSTGRES_USER=argus_rehearsal_user
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
DATABASE_URL=postgresql://argus_rehearsal_user:REPLACE_WITH_GENERATED_LOCAL_PASSWORD@127.0.0.1:55432/argus_migration_rehearsal
