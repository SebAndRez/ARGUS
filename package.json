{
  "name": "argus-grid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "prepare": "husky",
    "changelog:public": "node scripts/generate-public-changelog.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:note": "node scripts/new-release-note.mjs",
    "release:check": "npm run lint && npm run build && npm run db:validate && npm run db:generate && git diff --check",
    "start": "next start",
    "lint": "eslint",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate deploy",
    "audit:prod-seed": "tsx scripts/auditProdSeedData.ts",
    "db:setup:local": "tsx scripts/guardLocalDatabase.ts && prisma generate && prisma db push && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset:local:danger": "tsx scripts/guardLocalDatabase.ts && prisma db push --force-reset && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^4.16.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.9",
    "prisma": "^4.16.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
